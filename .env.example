# Copy this file to `.env` and fill in the values, then run/build with:
#   flutter run   --dart-define-from-file=.env
#   flutter build appbundle --release --dart-define-from-file=.env
#
# `.env` is gitignored. In CI these values come from repo secrets instead.

# Stadia Maps API key for map tiles.
# Free key (no credit card): https://client.stadiamaps.com/
# Add the bundle id `app.auaha.shoein` to the key's allowed properties.
STADIA_API_KEY=
